<!DOCTYPE html>
<html>
    <head>
        <link rel="stylesheet" href="/css/style.css" />
    </head>
    <body>
        <header>Labai geras headeris</header>
        <section class="table-section">
            <table border="1">
                <% for (let i = 0; i < products.length; i++) { %>
                <tr>
                    <td><%= products[i].id %></td>
                    <td><%= products[i].name %></td>
                    <td><%= products[i].price %></td>
                </tr>
                <% } %>
            </table>
        </section>
    </body>
</html>
